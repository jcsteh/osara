import time
import os
import glob
import sys
import zipfile
import shutil
import subprocess
import requests

AUTH_TOKEN = os.getenv("crowdinAuthToken")
if not AUTH_TOKEN:
	raise ValueError("crowdinAuthToken environment variable not set")
PROJECT_ID = 442894
MAIN_POT_FILE_ID = 4
WIN_INSTALLER_DIRECTORY = "winInstaller"
TRANSLATION_FILE_NAME = "osara.po"
TMP_DOWNLOAD_PATH = "locale.zip"

def request(path, method=requests.get, headers=None, **kwargs):
	headers = {"Authorization": "Bearer %s" % AUTH_TOKEN, **(headers or {})}
	r = method("https://api.crowdin.com/api/v2/%s" % path, headers=headers,
		**kwargs)
	# Convert errors to exceptions, but print the response before raising.
	try:
		r.raise_for_status()
	except requests.exceptions.HTTPError:
		print(r.json())
		raise
	return r

def projectRequest(path, **kwargs):
	return request("projects/%d/%s" % (PROJECT_ID, path), **kwargs)

def downloadTranslations():
	print("Requesting Crowdin build")
	r = projectRequest("translations/builds", method=requests.post, json={})
	buildId = r.json()["data"]["id"]
	print("Requesting translations download")
	while True:
		r = projectRequest("translations/builds/%d/download" % buildId)
		if r.status_code == 200:
			break
		if r.status_code == 202:
			print("Crowdin build in progress, retrying")
			time.sleep(5)
	url = r.json()["data"]["url"]
	print("Downloading translations")
	r = requests.get(url, stream=True)
	r.raise_for_status()
	# zipfile barfs with r.raw as an input stream, so we have to copy to a
	# temporary file.
	shutil.copyfileobj(r.raw, open(TMP_DOWNLOAD_PATH, "wb"))

def syncTranslations():
	downloadTranslations()
	print("Extracting translations")
	with zipfile.ZipFile(TMP_DOWNLOAD_PATH) as zf:
		zf.extractall()
	os.remove(TMP_DOWNLOAD_PATH)
	print("Committing new translations")
	subprocess.check_call(("git", "add", "--",
		*glob.glob("locale/**/*.po", recursive=True)))
	subprocess.check_call(("git", "commit", "-m", "Update translations."))
	print("Pushing to GitHub")
	subprocess.check_call(("git", "push"))

def findSingleFile(pattern):
	paths = glob.glob(pattern)
	if len(paths) != 1:
		raise RuntimeError(f"Expected exactly one file matching {pattern}, found {len(paths)}")
	return paths[0]

def listProjectResources(resource):
	resources = []
	offset = 0
	while True:
		r = projectRequest(resource, params={"limit": 500, "offset": offset})
		data = r.json()["data"]
		resources.extend(data)
		if len(data) < 500:
			return resources
		offset += len(data)

def getWinInstallerDirectoryId():
	for directory in listProjectResources("directories"):
		data = directory["data"]
		if data["name"] == WIN_INSTALLER_DIRECTORY and not data.get("directoryId"):
			return data["id"]
	print("Creating Crowdin directory for Windows installer translations")
	r = projectRequest("directories", method=requests.post,
		json={"name": WIN_INSTALLER_DIRECTORY})
	return r.json()["data"]["id"]

def findFileId(name, directoryId):
	for file in listProjectResources("files"):
		data = file["data"]
		if data["name"] == name and data.get("directoryId") == directoryId:
			return data["id"]
	return None

def uploadPotFile(potPath, fileId=None, directoryId=None):
	print("Uploading pot to Crowdin temporary storage")
	with open(potPath, "rb") as pot:
		r = request("storages", method=requests.post,
			headers={"Crowdin-API-FileName": TRANSLATION_FILE_NAME}, data=pot)
	storageId = r.json()["data"]["id"]
	if fileId is None:
		fileId = findFileId(TRANSLATION_FILE_NAME, directoryId)
	if fileId is not None:
		print("Updating pot file on Crowdin")
		r = projectRequest("files/%d" % fileId, method=requests.put,
			json={"storageId": storageId})
	else:
		print("Adding pot file to Crowdin")
		data = {"storageId": storageId, "name": TRANSLATION_FILE_NAME}
		if directoryId is not None:
			data["directoryId"] = directoryId
		r = projectRequest("files", method=requests.post, json=data)
	return r

def uploadPot():
	uploadPotFile(findSingleFile("locale/*.pot"), fileId=MAIN_POT_FILE_ID)
	directoryId = getWinInstallerDirectoryId()
	uploadPotFile(findSingleFile("locale/winInstaller/*.pot"), directoryId=directoryId)

if __name__ == "__main__":
	command = sys.argv[1]
	if command == "syncTranslations":
		syncTranslations()
	elif command == "uploadPot":
		uploadPot()
	else:
		raise ValueError("Unknown command")
